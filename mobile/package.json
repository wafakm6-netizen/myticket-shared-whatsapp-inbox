{
  "name": "myticket-inbox-app",
  "private": true,
  "version": "1.0.0",
  "description": "iPhone and Android app for the Myticket WhatsApp shared inbox (Capacitor shell around whatsapp.myticketom.com).",
  "scripts": {
    "sync": "cap sync",
    "assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#ff5a1f' --iconBackgroundColorDark '#ff5a1f' --splashBackgroundColor '#ffffff' --splashBackgroundColorDark '#161d25'",
    "ios": "cap open ios",
    "android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2"
  }
}
